<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_graph"
    app:startDestination="@id/loginFragment">
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.kurkotasks.view.onboarding.LoginFragment"
        android:label="@string/login_fragment"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.kurkotasks.view.onboarding.RegisterFragment"
        android:label="@string/register_fragment"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_personalInfo"
            app:destination="@id/personalInfo" />
    </fragment>
    <fragment
        android:id="@+id/personalInfo"
        android:name="com.example.kurkotasks.view.onboarding.PersonalInfo"
        android:label="@string/personal_info_fragment"
        tools:layout="@layout/fragment_personal_info">

        <argument
            android:name="userId"
            app:argType="string"/>

    </fragment>
</navigation>